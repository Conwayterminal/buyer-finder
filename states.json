{
 "NC": {
  "name": "North Carolina",
  "source": "NC OneMap statewide parcels",
  "url": "https://services.nconemap.gov/secure/rest/services/NC1Map_Parcels/MapServer/0",
  "point_layer": true,
  "page": 5000,
  "order": "objectid",
  "where": "parusedesc LIKE '%COMM%' OR parusedesc LIKE '%APART%' OR parusedesc LIKE '%INDUST%' OR parusedesc LIKE '%OFFICE%' OR parusedesc LIKE '%RETAIL%' OR parusedesc LIKE '%WAREHOUSE%' OR parusedesc LIKE '%HOTEL%' OR parusedesc LIKE '%MOTEL%' OR parusedesc LIKE '%MULTI%' OR parusedesc LIKE '%MIXED%' OR parusedesc LIKE '%STORE%' OR parusedesc LIKE '%SHOP%' OR parusedesc LIKE '%RESTAURANT%' OR parusedesc LIKE '%MANUFACT%' OR parusedesc LIKE '%Comm%' OR parusedesc LIKE '%Apart%' OR parusedesc LIKE '%Indust%' OR parusedesc LIKE '%Office%' OR parusedesc LIKE '%Retail%' OR parusedesc LIKE '%Warehouse%' OR parusedesc LIKE '%Hotel%' OR parusedesc LIKE '%Multi%' OR parusedesc LIKE '%Mixed%'",
  "fields": {
   "id": "parno",
   "owner": "ownname",
   "owner2": "ownname2",
   "mail": "mailadd",
   "mailcity": "mcity",
   "mailstate": "mstate",
   "addr": "siteadd",
   "town": "scity",
   "area": "cntyname",
   "zip": "szip",
   "use": "parusecode",
   "usedesc": "parusedesc",
   "mkt": "parval",
   "lot": "gisacres",
   "sold": "saledate",
   "price": null,
   "yb": "structyear"
  },
  "lot_acres": true,
  "area_is_county": true,
  "note": "NC OneMap has owner, mailing, use, value and sale date; sale prices are not in the statewide layer.",
  "classify": [
   {
    "regex": "APART|MULTI",
    "type": "Multifamily 5+ units"
   },
   {
    "regex": "MIX",
    "type": "Mixed-use"
   },
   {
    "regex": "HOTEL|MOTEL",
    "type": "Hotel"
   },
   {
    "regex": "OFFICE",
    "type": "Office"
   },
   {
    "regex": "INDUST|MANUFACT|WAREHOUSE",
    "type": "Industrial"
   },
   {
    "regex": "VACANT|LAND",
    "type": "Vacant land / development"
   },
   {
    "regex": ".",
    "type": "Retail / commercial"
   }
  ],
  "partition": "cntyname"
 },
 "DC": {
  "name": "District of Columbia",
  "source": "DC OCTO Common Ownership Lots",
  "url": "https://maps2.dcgis.dc.gov/dcgis/rest/services/DCGIS_DATA/Property_and_Land_WebMercator/FeatureServer/40",
  "page": 2000,
  "where": "CLASSTYPE IN ('2','3','4') OR PROPTYPE LIKE 'Residential-Apartment%' OR PROPTYPE LIKE 'Residential-Multi%'",
  "fields": {
   "id": "SSL",
   "owner": "OWNERNAME",
   "co": "CAREOFNAME",
   "mail": "ADDRESS1",
   "mailcity": "CITYSTZIP",
   "addr": "PREMISEADD",
   "town": "NBHDNAME",
   "use": "USECODE",
   "usedesc": "PROPTYPE",
   "mkt": "NEWTOTAL",
   "lot": "LANDAREA",
   "sold": "SALEDATE",
   "book": "BOOK_NUM",
   "page": "PAGE_NUM",
   "units": "COOPUNITS",
   "price": "SALEPRICE"
  },
  "area_default": "District of Columbia",
  "area_label": "District",
  "note": "DC lots with owner, care-of, use, assessed value, last sale date and price.",
  "classify": [
   {
    "regex": "APARTMENT|MULTI",
    "type": "Multifamily 5+ units"
   },
   {
    "regex": "MIXED|STORE.*APT|STORE.*RES",
    "type": "Mixed-use"
   },
   {
    "regex": "INDUSTRIAL|WAREHOUSE",
    "type": "Industrial"
   },
   {
    "regex": "GARAGE|PARKING",
    "type": "Garage / parking"
   },
   {
    "regex": "HOTEL|MOTEL",
    "type": "Hotel"
   },
   {
    "regex": "OFFICE",
    "type": "Office"
   },
   {
    "regex": "VACANT",
    "type": "Vacant land / development"
   },
   {
    "regex": ".",
    "type": "Retail / commercial"
   }
  ]
 },
