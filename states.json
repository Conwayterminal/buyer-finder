   "owner": "owner_name",
   "owner2": "owner_more",
   "mail": "own_add_l1",
   "mailcity": "own_add_l2",
   "mailstate": "own_add_l3",
   "addr": [
    "anumber",
    "st_pre_dir",
    "st_name",
    "st_pos_typ",
    "st_pos_dir"
   ],
   "town": "ctu_name",
   "area": "co_name",
   "zip": "zip",
   "use": "useclass1",
   "usedesc": "useclass2",
   "mkt": "emv_total",
   "lot": "acres_deed"
  },
  "lot_acres": true,
  "area_is_county": true,
  "note": "Counties that opted into statewide open parcel data (Hennepin, Ramsey and most metro counties). Owner, mailing, use class, estimated market value.",
  "classify": [
   {
    "regex": "APART|RES 4",
    "type": "Multifamily 5+ units"
   },
   {
    "regex": "INDUSTRIAL",
    "type": "Industrial"
   },
   {
    "regex": "VACANT",
    "type": "Vacant land / development"
   },
   {
    "regex": ".",
    "type": "Retail / commercial"
   }
  ],
  "partition": "co_name"
 },
 "GA": {
  "name": "Georgia (Johns Creek)",
  "source": "Fulton County GIS parcels",
  "area_label": "County",
  "note": "Johns Creek (north Fulton) only so far \u2014 the city publishes owner-level parcels; Fulton County's own service is not public. Atlanta/Fulton to be added from the county's data download.",
  "sources": [
   {
    "url": "https://services1.arcgis.com/bqfNVPUK3HOnCFmA/arcgis/rest/services/Parcels/FeatureServer/0",
    "page": 2000,
    "where": "ClassCode LIKE 'C%' OR ClassCode LIKE 'I%' OR ClassCode LIKE 'U%' OR (ClassCode LIKE 'R%' AND LivUnits>=4)",
    "fields": {
     "id": "ParcelID",
     "owner": "Owner",
     "mail": "OwnerAddr1",
     "mailcity": "OwnerAddr2",
     "addr": "Address",
     "town": "TaxDist",
     "use": "LUCode",
     "usedesc": "ClassCode",
     "mkt": "TotAppr",
     "lot": "LandAcres",
     "units": "LivUnits",
     "zone": "JCZoning"
    },
    "area_default": "Johns Creek",
    "lot_acres": true
   }
  ],
  "classify": [
   {
    "regex": "\\bR",
    "type": "Multifamily 5+ units"
   },
   {
    "prefix": [
     "3"
    ],
    "type": "Multifamily 5+ units"
   },
   {
    "regex": "\\bI",
    "type": "Industrial"
   },
   {
    "regex": "\\bU",
    "type": "Utility"
   },
   {
    "regex": ".",
    "type": "Retail / commercial"
   }
  ]
 },
