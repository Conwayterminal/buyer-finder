{
 "NC": {
  "name": "North Carolina",
  "source": "NC OneMap statewide parcels",
  "url": "https://services.nconemap.gov/secure/rest/services/NC1Map_Parcels/MapServer/0",
  "point_layer": true,
  "page": 5000,
  "order": "objectid",
  "where": "(parusecode IS NOT NULL AND (UPPER(parusedesc) LIKE '%COMM%' OR UPPER(parusedesc) LIKE '%APART%' OR UPPER(parusedesc) LIKE '%INDUST%' OR UPPER(parusedesc) LIKE '%OFFICE%' OR UPPER(parusedesc) LIKE '%RETAIL%' OR UPPER(parusedesc) LIKE '%WAREHOUSE%' OR UPPER(parusedesc) LIKE '%HOTEL%' OR UPPER(parusedesc) LIKE '%MOTEL%' OR UPPER(parusedesc) LIKE '%MULTI%' OR UPPER(parusedesc) LIKE '%MIXED%' OR UPPER(parusedesc) LIKE '%STORE%' OR UPPER(parusedesc) LIKE '%SHOP%' OR UPPER(parusedesc) LIKE '%RESTAURANT%' OR UPPER(parusedesc) LIKE '%MANUFACT%'))",
  "fields": {
   "id": "parno",
   "owner": "ownname",
   "owner2": "ownname2",
   "mail": "mailadd",
   "mailcity": "mcity",
   "mailstate": "mstate",
   "addr": "siteadd",
   "town": "scity",
   "area": "cntyname",
   "zip": "szip",
   "use": "parusecode",
   "usedesc": "parusedesc",
   "mkt": "parval",
   "lot": "gisacres",
   "sold": "saledate",
   "price": null,
   "yb": "structyear"
  },
  "lot_acres": true,
  "area_is_county": true,
  "note": "NC OneMap has owner, mailing, use, value and sale date; sale prices are not in the statewide layer.",
  "classify": [
   {
    "regex": "APART|MULTI",
    "type": "Multifamily 5+ units"
   },
   {
    "regex": "MIX",
    "type": "Mixed-use"
   },
   {
    "regex": "HOTEL|MOTEL",
    "type": "Hotel"
   },
   {
    "regex": "OFFICE",
    "type": "Office"
   },
   {
    "regex": "INDUST|MANUFACT|WAREHOUSE",
    "type": "Industrial"
   },
   {
    "regex": "VACANT|LAND",
    "type": "Vacant land / development"
   },
   {
    "regex": ".",
    "type": "Retail / commercial"
   }
  ]
 },
 "DC": {
  "name": "District of Columbia",
  "source": "DC OCTO Common Ownership Lots",
  "url": "https://maps2.dcgis.dc.gov/dcgis/rest/services/DCGIS_DATA/Property_and_Land_WebMercator/FeatureServer/40",
  "page": 2000,
  "where": "PROPTYPE IN ('COMMERCIAL','COMMERCIAL-GARAGE','COMMERCIAL-SPECIAL PURPOSE','INDUSTRIAL','RESIDENTIAL-MULTI FAMILY','MIXED USE','VACANT LAND') OR CLASSTYPE IN ('002','003','004')",
  "fields": {
   "id": "SSL",
   "owner": "OWNERNAME",
   "co": "CAREOFNAME",
   "mail": "ADDRESS1",
   "mailcity": "CITYSTZIP",
   "addr": "PREMISEADD",
   "town": "NBHDNAME",
   "area_default": "Washington",
   "use": "USECODE",
   "usedesc": "PROPTYPE",
   "mkt": "NEWTOTAL",
   "lot": "LANDAREA",
   "sold": "RECORDATION_DT",
   "book": "BOOK_NUM",
   "page": "PAGE_NUM",
   "units": "COOPUNITS"
  },
  "area_default": "District of Columbia",
  "area_label": "District",
  "note": "DC lots with owner, care-of, use, assessed value, last recordation date (no price in this layer).",
  "classify": [
   {
    "regex": "MULTI FAMILY",
    "type": "Multifamily 5+ units"
   },
   {
    "regex": "MIXED",
    "type": "Mixed-use"
   },
   {
    "regex": "INDUSTRIAL",
    "type": "Industrial"
   },
   {
    "regex": "GARAGE",
    "type": "Garage / parking"
   },
   {
    "regex": "VACANT",
    "type": "Vacant land / development"
   },
   {
    "regex": "COMMERCIAL|.",
    "type": "Retail / commercial"
   }
  ]
 },
 "VT": {
  "name": "Vermont",
  "source": "VCGI statewide standardized parcels",
  "url": "https://services1.arcgis.com/BkFxaEFNwHqX3tAw/arcgis/rest/services/FS_VCGI_OPENDATA_Cadastral_VTPARCELS_poly_standardized_parcels_SP_v1/FeatureServer/0",
  "page": 2000,
  "where": "CAT IN ('Commercial','Commercial Apt','Industrial','Mobile Home Park','Vacant Land') OR RESCODE IN ('C','I')",
  "fields": {
   "id": "SPAN",
   "owner": "OWNER1",
   "owner2": "OWNER2",
   "mail": "ADDRGL1",
   "mailcity": "CITYGL",
   "mailstate": "STGL",
   "addr": "E911ADDR",
   "town": "TNAME",
   "area": "TNAME",
   "use": "CAT",
   "usedesc": "DESCPROP",
   "mkt": "REAL_FLV",
   "lot": "ACRESGL"
  },
  "lot_acres": true,
  "area_label": "Town",
  "note": "Vermont grand list: owner, mailing, category, listed value; no sale dates in the statewide layer.",
  "classify": [
   {
    "regex": "APT|APART",
    "type": "Multifamily 5+ units"
   },
   {
    "regex": "INDUSTRIAL",
    "type": "Industrial"
   },
   {
    "regex": "VACANT",
    "type": "Vacant land / development"
   },
   {
    "regex": "MOBILE",
    "type": "Manufactured housing"
   },
   {
    "regex": ".",
    "type": "Retail / commercial"
   }
  ]
 },
 "MN": {
  "name": "Minnesota (open-data counties)",
  "source": "MnGeo open parcels",
  "url": "https://utility.arcgis.com/usrsvcs/servers/1627519e8d3f42bcb55532d48e9a61e5/rest/services/OpenParcels/plan_parcels_open/MapServer/0",
  "page": 5000,
  "order": "objectid",
  "where": "useclass1 LIKE 'Commercial%' OR useclass1 LIKE 'Industrial%' OR useclass1 LIKE 'Apartment%' OR useclass1 LIKE '%Apartments%' OR useclass1 LIKE 'Res 4 or more%' OR useclass2 LIKE 'Commercial%' OR useclass2 LIKE 'Industrial%' OR useclass2 LIKE 'Apartment%'",
  "fields": {
   "id": "state_pin",
   "owner": "owner_name",
   "owner2": "owner_more",
   "mail": "own_add_l1",
   "mailcity": "own_add_l2",
   "mailstate": "own_add_l3",
   "addr": [
    "anumber",
    "st_pre_dir",
    "st_name",
    "st_pos_typ",
    "st_pos_dir"
   ],
   "town": "ctu_name",
   "area": "co_name",
   "zip": "zip",
   "use": "useclass1",
   "usedesc": "useclass2",
   "mkt": "emv_total",
   "lot": "acres_deed"
  },
  "lot_acres": true,
  "area_is_county": true,
  "note": "Counties that opted into statewide open parcel data (Hennepin, Ramsey and most metro counties). Owner, mailing, use class, estimated market value.",
  "classify": [
   {
    "regex": "APART|RES 4",
    "type": "Multifamily 5+ units"
   },
   {
    "regex": "INDUSTRIAL",
    "type": "Industrial"
   },
   {
    "regex": "VACANT",
    "type": "Vacant land / development"
   },
   {
    "regex": ".",
    "type": "Retail / commercial"
   }
  ]
 }
}