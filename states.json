 "MN": {
  "name": "Minnesota (open-data counties)",
  "source": "MnGeo open parcels",
  "url": "https://utility.arcgis.com/usrsvcs/servers/1627519e8d3f42bcb55532d48e9a61e5/rest/services/OpenParcels/plan_parcels_open/MapServer/0",
  "page": 5000,
  "order": "objectid",
  "where": "useclass1 LIKE 'Commercial%' OR useclass1 LIKE 'Industrial%' OR useclass1 LIKE 'Apartment%' OR useclass1 LIKE '%Apartments%' OR useclass1 LIKE 'Res 4 or more%' OR useclass2 LIKE 'Commercial%' OR useclass2 LIKE 'Industrial%' OR useclass2 LIKE 'Apartment%'",
